# Everything the app image does not need. The collection arrives from
# Dockerfile.collection, so the whole of data/ is excluded -- which is what
# makes this build work on a runner that has no data/ at all.
#
# The seed is excluded with the rest: only 'export-seed' and 'import-seed' read
# it, both of them offline rebuild commands, and neither the server nor
# 'prepare' ever opens it.
.git
.gitignore
node_modules
test
tools
docs
data/seed
data/cache
data/og
data/media
data/pastperfect.db
data/pastperfect.db-shm
data/pastperfect.db-wal
*.md
!README.md
.nvmrc
tsconfig.json
.DS_Store
